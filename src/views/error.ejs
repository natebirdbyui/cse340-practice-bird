<%- include('partials/header') %>

<main class="error-container">
    <h1><%= title %></h1>
    <p><%= message %></p>

    <% if (NODE_ENV === 'development' && error.stack) { %>
        <pre class="error-stack"><%= error.stack %></pre>
    <% } %>

    <a href="/" class="btn">Return to Home</a>
</main>

<%- include('partials/footer') %>